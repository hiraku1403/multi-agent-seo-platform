{
    "version": 2,
    "builds": [
        {
            "src": "api/app.py",
            "use": "@vercel/python",
            "config": {
                "maxDuration": 60,
                "installCommand": "pip install -r requirements.txt"
            }
        },
        {
            "src": "frontend/public/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "api/app.py"
        },
        {
            "src": "/(.*)",
            "dest": "frontend/public/$1"
        }
    ],
    "functions": {
        "api/app.py": {
            "memory": 1024,
            "maxDuration": 60
        }
    }
}
