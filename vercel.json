{
    "version": 2,
    "builds": [
        {
            "src": "api/app.py",
            "use": "@vercel/python"
        },
        {
            "src": "frontend/public/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "api/app.py"
        },
        {
            "src": "/(.*)",
            "dest": "frontend/public/$1"
        }
        }
    ],
    "env": {
        "OPENAI_API_KEY": "@openai_api_key",
        "TAVILY_API_KEY": "@tavily_api_key",
        "SERPER_API_KEY": "@serper_api_key"
    }
}
