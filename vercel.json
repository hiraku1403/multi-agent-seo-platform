{
    "version": 2,
    "builds": [
        {
            "src": "src/api/app.py",
            "use": "@vercel/python"
        },
        {
            "src": "frontend/public/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "src/api/app.py"
        },
        {
            "src": "/(.*)",
            "dest": "frontend/public/$1"
        }
        
    ]
}
